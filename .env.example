# =========================================
# 환경변수 예시 파일 (이 파일은 GitHub에 올림)
# 복사해서 .env 파일을 만들고 실제 값을 넣으세요.
# =========================================

# 서버 포트
PORT=3000

# MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dasi_na

# Aiven 등 클라우드 DB를 쓸 때만 true (5일차)
DB_SSL=false

# 로그인 세션 암호 키 (아무 긴 문장)
SESSION_SECRET=

# 처음 만들 관리자 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=